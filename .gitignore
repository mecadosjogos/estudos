# Ambiente
.env
.venv/
__pycache__/
*.pyc

# Banco e mídia (só existem na VPS ou local; nunca versionados)
data/*.db
data/*.db-wal
data/*.db-shm
data/media/original/*
!data/media/original/.gitkeep
data/media/web/*
!data/media/web/.gitkeep
data/media/guia-audio/*
!data/media/guia-audio/.gitkeep
data/uploads/
data/materials/

# Áudios originais arquivados localmente
archive/*
!archive/.gitkeep

# Área de trabalho temporária do worker (segmentos baixados, concatenação)
worker/tmp/

# Backups
backups/

# Logs do processamento automático de aulas (processar-aulas.bat)
logs/

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Estado interno do assistente de codificação (skills são a exceção — fazem
# parte do projeto, não do estado local de uma sessão)
.claude/*
!.claude/skills/
!.claude/skills/**

# Testes / cobertura
.pytest_cache/
htmlcov/
.coverage
test_debug.db
