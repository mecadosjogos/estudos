# Ambiente
.env
.venv/
__pycache__/
*.pyc

# Banco e mídia (só existem na VPS ou local; nunca versionados)
data/*.db
data/*.db-wal
data/*.db-shm
data/media/original/*
!data/media/original/.gitkeep
data/media/web/*
!data/media/web/.gitkeep
data/uploads/

# Áudios originais arquivados localmente
archive/*
!archive/.gitkeep

# Área de trabalho temporária do worker (segmentos baixados, concatenação)
worker/tmp/

# Backups
backups/

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Estado interno do assistente de codificação
.claude/

# Testes / cobertura
.pytest_cache/
htmlcov/
.coverage
