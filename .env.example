# Papel deste processo: server (VPS) ou worker (máquina com GPU)
ROLE=server

# Domínio (temporário) — usado pelo Caddy e para montar URLs, nunca persistido no banco
DOMAIN=drwyver.mecadosjogos.app.br

# Token de acesso inicial — trocado por cookie de sessão no primeiro acesso (?k=<TOKEN>)
ACCESS_TOKEN=

# Banco SQLite (caminho dentro do container/host)
DATABASE_PATH=./data/estudos.db

# --- Necessário só a partir da fase 6 (IA) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MONTHLY_BUDGET_USD=40

# --- Necessário só a partir da fase 4 (worker remoto) ---
# Nome de identificação deste worker (aparece em qual máquina transcreveu a aula)
WORKER_NAME=

# URL do server que o worker consulta para pegar jobs
SERVER_URL=https://drwyver.mecadosjogos.app.br

# --- Necessário só a partir da fase 9 (Google Docs) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
