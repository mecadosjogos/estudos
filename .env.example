# Papel deste processo: server (VPS) ou worker (máquina com GPU)
ROLE=server

# Domínio (temporário) — hoje só informativo (quem decide o domínio servido
# são as labels do Traefik em docker-compose.yml); nunca persistido no banco
DOMAIN=drwyver.mecadosjogos.app.br

# Assina o cookie de sessão do login -- defina um valor forte em produção.
# Sem isso, cai no padrão "dev-secret-troque-isto" publicado neste
# repositório, o que permite forjar sessão de qualquer usuário.
SESSION_SECRET=

# Credencial de máquina (não de pessoa): usada só pelo worker de
# transcrição e pelo Atalho do iOS, como header Authorization: Bearer
# <TOKEN>. Sem relação com o login por usuário/senha em /login.
ACCESS_TOKEN=

# Banco SQLite (caminho dentro do container/host)
DATABASE_PATH=./data/estudos.db

# --- Necessário só a partir da fase 6 (IA) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MONTHLY_BUDGET_USD=40

# --- Necessário só a partir da fase 4 (worker remoto) ---
# Nome de identificação deste worker (aparece em qual máquina transcreveu a aula)
WORKER_NAME=

# URL do server que o worker consulta para pegar jobs
SERVER_URL=https://drwyver.mecadosjogos.app.br

# --- Necessário só pra scripts/backup_from_vps.py ---
# Login de um usuário com papel admin -- se ausente, o script pergunta
# interativamente. Nunca fica hardcoded no script.
BACKUP_ADMIN_USERNAME=
BACKUP_ADMIN_PASSWORD=

# --- Acesso SSH manual à VPS (rodar migração/Watchtower na mão -- ver
# README.md, "Deploy automático a cada push"). NUNCA committar valor real
# aqui nem em nenhum arquivo versionado -- repositório é público. Mesma
# VPS/chave dedicada usada pelos secrets do GitHub Actions (VPS_HOST/
# VPS_USER/VPS_SSH_KEY), só que como arquivo local em vez de secret de CI. ---
VPS_SSH_HOST=
VPS_SSH_USER=
VPS_SSH_KEY_PATH=

# Modelo de produção — não trocar por um menor sem motivo forte (precisão em
# termo jurídico/latim cai bastante). float16 exige GPU; troque compute_type
# para "int8" só em GPU sem VRAM suficiente para float16.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Válvula de emergência "transcrever na VPS agora" (roda no server, CPU)
WHISPER_VPS_MODEL=medium
WHISPER_VPS_COMPUTE_TYPE=int8

# --- Necessário só a partir da fase 9 (Google Docs) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# --- IA local das dissertativas (worker/ia_local.py, fase 13b) ---
# Só na máquina com GPU. O modelo padrão DESTA máquina e a autorização do
# Claude NÃO ficam aqui (este .env sincroniza entre máquinas pelo OneDrive):
# use `worker\ia_local.ps1 -Comando usar-modelo -Modelo <id>`, que grava em
# %LOCALAPPDATA%\Estudos\ia_local.json. Os valores abaixo são só o padrão.
# LLAMACPP_LOCAL_DIR=..\LlamaCppLocal
# IA_LOCAL_MODELO=qwen3.5-4b
# IA_LOCAL_MODELO_RESERVA=qwen3.5-4b
# IA_LOCAL_PORTA=8200
# IA_LOCAL_OCIOSO_S=600
# CLAUDE_BIN=claude
